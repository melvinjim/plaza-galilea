# Copia este archivo a .env y rellena los valores:  cp .env.example .env
# .env está en .gitignore y no se sube nunca. Este ejemplo sí.
#
# El .env es SOLO para correr en tu computador. En Vercel las variables van en
# Settings → Environment Variables; en Render, en el panel del servicio.


# ── Obligatoria ──────────────────────────────────────────────────────────────

# Cadena de conexión de PostgreSQL.
# En Supabase: Project Settings → Database → Connection string → pestaña
# "Transaction pooler" (la del puerto 6543, NO la conexión directa).
# Cambia [YOUR-PASSWORD] por la contraseña del proyecto.
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.pooler.supabase.com:6543/postgres


# ── Recomendadas ─────────────────────────────────────────────────────────────

# Contraseña del panel en /admin. Si se deja vacía usa "galilea2026",
# que es pública porque está en el repo: defínela antes de publicar.
ADMIN_PASSWORD=

# WhatsApp del restaurante, con indicativo y sin signos. Solo se usa si en el
# panel no se ha guardado otro.
WHATSAPP=573152337931


# ── Opcionales ───────────────────────────────────────────────────────────────

# Puerto local. Por defecto 3000.
PORT=3000

# Conexiones a Postgres por instancia. Por defecto 3. Súbelo solo si el
# servidor es uno solo y permanente; en serverless, déjalo bajo.
PG_POOL_MAX=3
